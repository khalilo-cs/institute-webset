<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: a shortcut straight to the admin panel (it still asks for the admin login). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="admin"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_admin_short"
        android:shortcutLongLabel="@string/shortcut_admin_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetClass="com.alfakhamah.store.MainActivity"
            android:targetPackage="com.alfakhamah.store">
            <extra
                android:name="start_path"
                android:value="/admin/" />
        </intent>
    </shortcut>
</shortcuts>
